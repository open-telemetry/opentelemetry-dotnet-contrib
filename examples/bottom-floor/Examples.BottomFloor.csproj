<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 is listed first so the example runs on the current SDK's runtime;
      the minimum example target is kept for convention.
    -->
    <TargetFrameworks>net10.0;$(DefaultTargetFrameworkForExampleApps)</TargetFrameworks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenTelemetry.Sampler.BottomFloor\OpenTelemetry.Sampler.BottomFloor.csproj" />
  </ItemGroup>

</Project>
